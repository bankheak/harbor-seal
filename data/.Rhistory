# Set working directory here
setwd("C:/Users/bankh/My_Repos/habor-seal/data")
full.data<- read.csv("full.data.csv")
str(full.data)
require(glmmTMB) # for glmm
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(as.factor(month) + 0 | year), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(0 | month), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(1 | month), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(1 | as.factor(month)), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(1 + 0 | as.factor(month)), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(as.factor(month) + 0 | year), data = full.data,
family = nbinom2, zi = ~ 1)
model1<- glmmTMB(seals ~ noise*site + tide + time +
ar1(1 | year), data = full.data,
family = nbinom2, zi = ~ 1)
?ar1()
